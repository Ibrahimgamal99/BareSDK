[submodule "third_party/re"]
	path = third_party/re
	url = https://github.com/baresip/re.git
	# Tested against: main branch (pin to a release tag for production)

[submodule "third_party/baresip"]
	path = third_party/baresip
	url = https://github.com/baresip/baresip.git
	# Tested against: main branch (pin to a release tag for production)

[submodule "third_party/mbedtls"]
	path = third_party/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
	# Required only for mobile builds (LIBBARE_TLS=mbedtls).
	# Pin to a specific release tag — must match what re was compiled with
	# to avoid mbedTLS ABI/symbol drift (especially in dtls_srtp).
	# Recommended: v3.6.x (LTS)
	branch = v3.6-branch
[submodule "third_party/opus"]
	path = third_party/opus
	url = https://github.com/xiph/opus.git
