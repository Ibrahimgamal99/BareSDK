/* EchoSDK-patched: does `sa` match the address the call signals from? */
static bool echosdk_sig_handler(const char *ifname, const struct sa *sa,
				void *arg)
{
	(void)ifname;

	return sa_cmp(arg, sa, SA_ADDR);
}


/* EchoSDK-patched: gather only on the interface that carries the signalling.
 *
 * A component has one wildcard-bound socket, shared by every candidate this
 * handler adds.  So a second interface does not buy a second path: it buys a
 * second *label* on the one socket, whose packets the kernel still routes by
 * destination.  The label is not merely redundant, it is wrong, and the SDP
 * ends up carrying an address the media will never come from — measured
 * on-device (2026-08-31, Wi-Fi and cellular both up): the srflx gathered from
 * the cellular base came back with the Wi-Fi WAN's address, that candidate
 * became the default, and it was the address the answer signalled while every
 * packet left over Wi-Fi.  ICE recovered by learning the real address as
 * peer-reflexive, and each of those calls then had a signalled address and a
 * selected address that disagreed.
 *
 * Keeping the base that matches the session's local address keeps the SDP
 * describing the path the media actually takes.  It is not a NAT fix — a NAT
 * that maps one socket to different public addresses per destination still
 * defeats any address STUN reports — which is why the DTLS role
 * (cmake/patches/dtls_srtp-setup.new) is what makes a call survive that, and
 * this only stops the SDK from adding a disagreement of its own.
 *
 * Filtering is skipped unless the signalling address is itself one of the
 * interfaces, so a session laddr that is unset or stale can never leave a call
 * with no candidates at all.  A handover re-gathers under a new laddr (see
 * src/ice_shim.c) and picks up the interface that carries the call then.
 *
 * That same check is what makes it safe to filter across address families:
 * once `sig` is known to be a live local address, candidates in its family
 * exist — `sig` itself is one — so dropping the other family cannot starve the
 * call.  It used to be waved through instead, on the same "never leave a call
 * with no candidates" reasoning, and that is the one case where the reasoning
 * does not hold.
 *
 * Dropping it is the point.  A component has one socket in one family, so a
 * candidate from the other family is not a path the media could take even in
 * principle — it is a label the peer will faithfully pair against and then
 * wait out.  Measured on-device (2026-09-02, outbound over WSS on a
 * dual-stack cellular link): an `af=AF_INET` call offered both of the
 * device's IPv6 host addresses, the PBX paired them against its own fe80::
 * link-local, and two of the four pairs in the check list could never
 * succeed.  The srflx came back with an IPv6 base for the same reason — the
 * highest-priority interface it was gathered against was one of those.
 */
static bool echosdk_if_signalling(struct mnat_media *m, const struct sa *sa)
{
	const struct sa *sig;

	if (!m->sess || !m->sess->sdp)
		return true;

	sig = sdp_session_laddr(m->sess->sdp);
	if (!sig || !sa_isset(sig, SA_ADDR))
		return true;

	if (!net_laddr_apply(baresip_network(), echosdk_sig_handler,
			     (void *)sig))
		return true;

	return sa_cmp(sig, sa, SA_ADDR);
}


static bool if_handler(const char *ifname, const struct sa *sa, void *arg)
{
	struct mnat_media *m = arg;
	uint16_t lpref;
	const struct sa *def;
	unsigned i;
	int err = 0;

	/* Skip loopback and link-local addresses */
	if (sa_is_loopback(sa) || sa_is_linklocal(sa))
		return false;

	if (!net_af_enabled(baresip_network(), sa_af(sa)))
		return false;

	/* EchoSDK-patched */
	if (!echosdk_if_signalling(m, sa)) {
		ice_printf(m, "skipped interface: %s:%j — the call signals"
			   " from %j\n",
			   ifname, sa, sdp_session_laddr(m->sess->sdp));
		return false;
	}
