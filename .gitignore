# Third party dependencies — fetched by the build, never committed.
third_party/
.gitmodules

# Build output
build/
dist/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Compiled binaries / libraries
*.a
*.so
# ...except the prebuilt Android libs shipped inside the Flutter plugin
!bindings/flutter/android/src/main/jniLibs/**/*.so
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
*.ipa
*.apk

# Object files
*.o
*.obj
*.lo
*.slo

# Python bindings
# Depth-independent so they also catch bindings/python/vox_sdk/... — the
# previous anchored forms missed the inner package directory.
__pycache__/
*.pyc
*.pyo
*.egg-info/
bindings/python/build/
bindings/python/dist/
# Copied here by bindings/python/build.sh from dist/<platform>/
bindings/python/vox_sdk/voxsdk.so
bindings/python/vox_sdk/voxsdk.pyd
bindings/python/vox_sdk/voxsdk.dylib

# C++ bindings build artifacts
bindings/cpp/build/

# Flutter / Dart bindings
# Machine-local Android/Flutter SDK paths — generated per developer.
local.properties
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
bindings/flutter/example/build/

# Editor / IDE
.vscode/
.vs/
*.suo
*.user
*.sdf
*.opensdf
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code / Kilo
.claude/
.kilo/
